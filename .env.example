# Copy this file to .env and fill in every value:   cp .env.example .env
# .env is git-ignored: the real passwords never go into the repository.
#
# Make a strong random password with:   openssl rand -base64 24
# docker compose reads .env by itself. docker-compose.prod.yml refuses to start if a value is missing,
# and the gateway refuses the placeholder "change-me" as the admin password.

# The public address of the demo, without a trailing slash (Grafana builds its links from it).
PUBLIC_URL=https://payswitch.example.com

# The admin login for the chaos sliders, bulk load, recon, settlement, reseed and Grafana.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# The database password. Used by Postgres and by the four services that connect to it.
# Postgres only applies it when it creates its data volume for the first time: to change it later,
# change it inside Postgres too (ALTER USER payswitch PASSWORD '...'), or start over with "down -v".
POSTGRES_PASSWORD=change-me

# Grafana's own admin password (only needed to EDIT dashboards; viewing needs ADMIN_PASSWORD).
GRAFANA_ADMIN_PASSWORD=change-me

# The port the gateway listens on, on 127.0.0.1 only. Caddy forwards HTTPS traffic to it.
WEB_PORT=8000

# On the SERVER only (see DEPLOY.md step 9), uncomment so every "docker compose" command uses the
# production settings without typing -f twice:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
