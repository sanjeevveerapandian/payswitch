<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent: holds shared settings. It produces no jar itself (packaging = pom). -->
    <groupId>com.payswitch</groupId>
    <artifactId>payswitch-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>PaySwitch (parent)</name>

    <!-- Child modules, built in dependency order. More come in later phases. -->
    <modules>
        <module>common</module>
        <module>ledger-core</module>
        <module>bank-service</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <spring-boot.version>3.5.16</spring-boot.version>
    </properties>

    <!-- dependencyManagement only fixes VERSIONS. A child still has to ask for a
         dependency, but then it does not repeat the version. -->
    <dependencyManagement>
        <dependencies>
            <!-- Our own modules, so services can depend on them without a version. -->
            <dependency>
                <groupId>com.payswitch</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payswitch</groupId>
                <artifactId>ledger-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Listed first, so this JUnit version wins over the one in Spring Boot's list. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Boot's tested version list (Spring, Postgres driver, Flyway, Testcontainers...).
                 Imported as a BOM instead of used as <parent>, because our parent is this pom. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- pluginManagement does the same for build plugins. -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <!-- Keep method parameter names in the .class files. Spring needs them to
                             match @PathVariable String vpa to "{vpa}" in the URL. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <!-- Off by default: the parent, common and ledger-core have no main class.
                         Each runnable service turns it back on in its own pom. -->
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
